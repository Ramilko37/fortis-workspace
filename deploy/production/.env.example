HTTP_PORT=80

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

APP_AUTH_JWTSECRET=change-me-to-a-long-random-secret
APP_AUTH_JWTEXPIRY=24

# Set to true only when the Next.js proxy guard should require auth.
FORTIS_AUTH_ENABLED=false

# Optional deploy notifications for deploy-with-notify.sh.
# Keep the full webhook URL only in the server-local .env.
DEPLOY_NOTIFY_WEBHOOK_URL=
FORTIS_DEPLOY_ENV=dev-vm
FORTIS_APP_URL=http://85.208.87.187/
